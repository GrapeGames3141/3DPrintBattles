; Engine configuration file.
; Generated for PrintForge Legends — Godot 4.x
; Open this folder in Godot 4 to load the project.

config_version=5

[application]

config/name="PrintForge Legends"
config/version="0.1.0"
config/description="Collect magical 3D-printed creatures and battle in this unique creature collector set in a futuristic magical workshop."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/ui/icon.png"

[autoload]

GameData="*res://data/GameData.gd"
SaveManager="*res://scripts/SaveManager.gd"
BattleManager="*res://scripts/BattleManager.gd"
SceneTransition="*res://scripts/SceneTransition.gd"
AudioManager="*res://scripts/AudioManager.gd"
SteamManager="*res://scripts/SteamManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/initial_position_type=1

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.102, 0.102, 0.18, 1)

[gui]

theme/custom="res://assets/ui/PrintForgeTheme.tres"

[input]

ui_confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}

ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":1,"pressure":0.0,"pressed":false,"script":null)
]
}

[filesystem]

import/blender/enabled=false
