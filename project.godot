; PrintForge
; Desktop launches the tactical combat POC. Mobile remains the separate model inspector app.
config_version=5

[application]

config/name="PrintForge Combat POC"
config/name.mobile="PrintForge Model Inspector"
run/main_scene="res://combat_main.tscn"
run/main_scene.mobile="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/handheld/orientation.mobile=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.025, 0.045, 0.08, 1)

[input]

play_summon={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32,"unicode":32)]
}
